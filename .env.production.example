# ── 복사해서 .env.production 만들고 실값 채우기 ──
#   cp .env.production.example .env.production
#   (.env.production 은 git에 안 올라감 / 컨테이너에 마운트됨)
#   실행: docker compose --env-file .env.production up -d --build

# ===== DB (Spring + MySQL 컨테이너 공용) =====
# dbUrl 의 DB명은 아래 MYSQL_DATABASE 와 같아야 함.
#  - 단일 호스트(docker-compose.yml): host = 컨테이너명 'db'
#  - 2대 분리(App/DB): host = DB서버 PRIVATE IP  ← 예: jdbc:mysql://172.31.12.34:3306/...
dbUrl=jdbc:mysql://db:3306/assetbox?serverTimezone=UTC&characterEncoding=UTF-8
dbUserName=assetbox
dbPassWord=CHANGE_ME_strong_db_password
MYSQL_DATABASE=assetbox
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# ===== Redis (컨테이너명 'redis') =====
redis.host=redis
redis.port=6379

# ===== 서비스 도메인 (CORS 허용 origin / OAuth redirect 기준) =====
baseUrl=https://your-domain.com

# ===== JWT / 토큰 (실 운영용 강한 랜덤값으로 교체) =====
base64UuidKey=CHANGE_ME_base64_secret
vanillaKey=CHANGE_ME_secret
accessTokenTime=1800000
refreshTokenTime=604800000

# ===== OAuth (Google / Naver 콘솔에서 발급, redirect는 baseUrl 기준) =====
googleClientId=CHANGE_ME
googleClientSecretKey=CHANGE_ME
naverClientId=CHANGE_ME
naverClientSecretKey=CHANGE_ME

# ===== AWS S3 (파일 업로드/다운로드) =====
s3BucketName=CHANGE_ME
s3AccessKey=CHANGE_ME
s3SecretKey=CHANGE_ME
s3Region=ap-northeast-2

# ===== 이미지 태그 (ghcr pull 시) =====
APP_IMAGE=ghcr.io/teabag-be/asset-box:latest
FRONT_IMAGE=ghcr.io/teabag-be/asset-box-front:latest
